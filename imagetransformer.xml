<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_IMAGETRANSFORMER</name>
    <creationDate>2025-02</creationDate>
    <author>DI Philipp Salmutter</author>
    <authorEmail>philipp@salmutter.net</authorEmail>
    <copyright>(C) 2025 salmutter.net</copyright>
